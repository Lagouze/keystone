# Keystone — variables d'environnement attendues.
# Copier en .env (jamais commité). Testnet uniquement.

# --- Keeper et scripts ---
ISSUER_SECRET=          # émetteur de KMMF et KBOND
FUND_SECRET=            # compte du fonds de démo (bootstrap, e2e, SIGNER=keeper)
BANK_SECRET=            # compte de la banque de démo (bootstrap : trustlines)
KEEPER_SECRET=          # déploie les vaults, poste les marges, soumet le règlement
SIGNER=freighter        # freighter | keeper
PORT=8787

# --- Dashboard (app/) ---
VITE_KEEPER_URL=http://localhost:8787/api
VITE_USE_MOCKS=false
# Mode mocks uniquement : freighter (signature simulée) ou keeper.
VITE_MOCK_SIGNER=freighter

# --- Keeper backend ---
# testnet = vrai vault Soroban sur Stellar Testnet (transactions réelles) ; fake = vault en mémoire, hashes factices.
# KEEPER_ALLOWED_ORIGINS : origines web supplémentaires autorisées (CORS), séparées par des virgules ; localhost est autorisé en local seulement : un keeper hébergé le refuse.
KEEPER_BACKEND=
KEEPER_ALLOWED_ORIGINS=

# --- Hosted keeper (Render ou Railway) : voir docs/deploy.md ---
# KEEPER_HOST=0.0.0.0              # défaut 127.0.0.1. Hors loopback, le keeper est public : les 4 variables ci-dessous deviennent obligatoires.
# KEEPER_ACCESS_TOKENS=            # codes d'accès des routes POST, séparés par des virgules, 32 caractères minimum chacun (openssl rand -hex 24). Jamais dans Vercel.
# (sur un keeper hébergé, KEEPER_ALLOWED_ORIGINS ci-dessus liste les origines HTTPS exactes du site ; * remplace un seul segment de nom)
# KEEPER_PUBLIC_HOSTS=             # nom d'hôte public du keeper, sans schéma (xxx.onrender.com ou xxx.up.railway.app)
# KEEPER_DATA_DIR=/data            # dossier durable (volume) : session, caches Euribor et marché
# KEEPER_TRUST_PROXY_HOPS=1        # nombre de proxys devant le keeper
